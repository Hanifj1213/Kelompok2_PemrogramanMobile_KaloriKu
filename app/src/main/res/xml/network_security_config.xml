<?xml version="1.0" encoding="utf-8"?>
<!--
  Server AI pengembangan berjalan di komputer sendiri lewat HTTP polos, sedangkan
  Android melarang HTTP polos secara bawaan. Di sini hanya alamat server lokal yang
  diizinkan (10.0.2.2 = komputer dilihat dari emulator), selebihnya tetap wajib HTTPS.

  Kalau nanti memakai HP asli lewat Wi-Fi, tambahkan IP LAN komputer di domain-config
  dalam file ini, contohnya: <domain includeSubdomains="false">192.168.1.10</domain>
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
