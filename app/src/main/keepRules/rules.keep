# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# ML Kit mendaftarkan komponen lewat refleksi pada `*Registrar`. Tanpa aturan ini,
# build release melempar NoSuchMethodException dan barcode gagal jalan.
-keep class com.google.mlkit.**Registrar { public <init>(); }
